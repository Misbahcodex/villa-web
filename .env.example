# ==============================================================================
# Rizq Luxurious Villa — Environment Variables Configuration
# ==============================================================================

# Core App Configuration
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=https://rizqvilla.com
NEXT_PUBLIC_SITE_URL=https://rizqvilla.com

# Feature Flags (All degrade gracefully to zero-config offline mode)
ENABLE_BACKEND=true
ENABLE_TELEGRAM=false
ENABLE_EMAIL=false
ENABLE_ICAL_SYNC=true
ENABLE_PAYMENTS=false # Stub extension point for future Stripe/Telr integration

# Supabase (Postgres Database & Advisory Locks)
# Leave blank to run 100% in-memory / JSON local fallback store
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (Email Notifications)
RESEND_API_KEY=re_your_api_key_here
OWNER_EMAIL=manager@rizqvilla.com
NOTIFICATION_FROM_EMAIL=reservations@rizqvilla.com

# Telegram Bot (Instant Owner Notifications with Confirm/Decline Buttons)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_32_chars_min

# Admin Operations Dashboard Authentication
ADMIN_PASSWORD=demo_admin_2026
ADMIN_SESSION_SECRET=rizq_luxury_villa_dubai_secret_token_32_chars_demo

# Security & Background Tasks
CRON_SECRET=demo_cron_secret_2026
ICAL_FEED_TOKEN=rizq_demo_ical_token_secure_2026
RETENTION_DAYS=90
